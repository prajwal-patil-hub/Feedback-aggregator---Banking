# Bank Feedback Aggregator — example environment variables
# Copy to `.env` and fill in. `.env` is gitignored.

# ---- Postgres (consumed by n8n Postgres credential "Postgres Main") ----
PGHOST=localhost
PGPORT=5432
PGDATABASE=bank_feedback
PGUSER=bank_feedback
PGPASSWORD=change-me

# ---- Google Places API (credential: "Google Places API", HTTP Header Auth) ----
# Header name: X-Goog-Api-Key   Header value: <this key>
GOOGLE_PLACES_API_KEY=AIza...replace...

# ---- Twitter / X API v2 (credential: "Twitter Bearer", HTTP Header Auth) ----
# Header name: Authorization   Header value: Bearer <this token>
TWITTER_BEARER_TOKEN=AAAA...replace...

# ---- OpenAI (credential: "OpenAI API", HTTP Header Auth) ----
# Header name: Authorization   Header value: Bearer <this key>
OPENAI_API_KEY=sk-...replace...

# ---- Slack bot (credential: "Slack Bot", Slack OAuth2) ----
SLACK_BOT_TOKEN=xoxb-...replace...
SLACK_ALERT_CHANNEL=#bank-feedback-alerts
SLACK_OPS_CHANNEL=#bank-feedback-ops

# ---- Generic scraper (MouthShut / Trustpilot ingestor endpoint) ----
# Must return either a JSON array of review objects or { "reviews": [...] }
# Objects: { review_text, rating, author, date, url, source_name }
SCRAPER_URL=https://scraper.internal.example.com/reviews
