# Bank Feedback Insights Agent — env
# Copy to `.env.local` (gitignored) when running locally,
# or add these to Vercel's Environment Variables UI for production.

# Google AI Studio key (free tier) — https://aistudio.google.com/app/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.0-flash-001)
# GEMINI_MODEL=gemini-2.0-flash-001
